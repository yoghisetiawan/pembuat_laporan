# Wajib: kunci API Anthropic (Claude) untuk seluruh penalaran AI
ANTHROPIC_API_KEY=
# Opsional: model Claude (default claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Opsional: aktifkan transkripsi berkas audio (Gemini). Tanpa ini, gunakan dikte suara langsung di browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
