# ===== AI =====
# Wajib: kunci API Anthropic (Claude) untuk seluruh penalaran AI
ANTHROPIC_API_KEY=
# Opsional: model Claude (default claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Opsional: transkripsi berkas audio (Gemini). Tanpa ini, gunakan dikte suara langsung di browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== Supabase (login + penyimpanan cloud) =====
# Supabase Dashboard → Project Settings → API. Tanpa dua nilai ini aplikasi berjalan mode lokal (IndexedDB).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) atau anon key lama — keduanya aman untuk browser karena data dilindungi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hanya untuk keadaan darurat: izinkan akses tanpa login di produksi (TIDAK disarankan)
# ALLOW_ANONYMOUS=true
